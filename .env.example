# Salin file ini menjadi .env lalu sesuaikan.

# true hanya di komputer sendiri. WAJIB false di server.
DJANGO_DEBUG=false
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Domain situs, pisahkan dengan koma
DJANGO_ALLOWED_HOSTS=arsip.domainanda.id
DJANGO_CSRF_TRUSTED_ORIGINS=https://arsip.domainanda.id

# Folder database + file PDF (default: ./data)
# ARSIP_DATA_DIR=/srv/arsip/data

ARSIP_NAMA_SITUS=ARSIP SESPIMMA
ARSIP_MAKS_UKURAN_MB=50
# Watermark nama & NRP pembaca di setiap halaman PDF
ARSIP_WATERMARK=true
# true = semua pengguna boleh mengunduh PDF (tetap ber-watermark). false = hanya admin.
ARSIP_IZINKAN_UNDUH=false
# true bila di belakang Caddy/Nginx (setup docker-compose sudah begitu)
ARSIP_DI_BELAKANG_PROXY=true

# Dipakai docker-compose / Caddy untuk sertifikat HTTPS otomatis
DOMAIN=arsip.domainanda.id

# OCR untuk PDF hasil scan (di Docker sudah diatur otomatis ke /opt/tessdata)
# ARSIP_TESSDATA=/srv/arsip/tessdata
# ARSIP_OCR_BAHASA=ind+eng
# ARSIP_OCR_DPI=300
# ARSIP_OCR_OTOMATIS=true

# Batas percobaan login: dikunci N menit setelah sekian kali salah kata sandi
# ARSIP_LOGIN_MAKS_GAGAL=5
# ARSIP_LOGIN_KUNCI_MENIT=15

# Folder tujuan `manage.py cadangkan` (sebaiknya disk/layanan lain)
# ARSIP_CADANGAN_DIR=/srv/cadangan-arsip
